# AfyaWise website environment variables. Copy to .env for local use; set them in Vercel
# (Project → Settings → Environment Variables) for Preview and Production. Never commit real values.

# ---------------------------------------------------------------------------------------------
# Content review
# ---------------------------------------------------------------------------------------------
# true on Preview deployments: shows TODO_CONFIRM content with an amber badge for the team to review.
# Must be false (or unset) in Production.
PUBLIC_SHOW_UNCONFIRMED=false

# ---------------------------------------------------------------------------------------------
# Email delivery for the contact, proposal and volunteer forms
# ---------------------------------------------------------------------------------------------
# resend | postmark | log   ("log" prints to the console: development only; refused in Vercel Production)
MAIL_PROVIDER=log
MAIL_API_KEY=
# Must be a sender verified with the provider (add its DNS records for afyawise.org).
MAIL_FROM="AfyaWise website <website@afyawise.org>"
# Fallback inbox.
CONTACT_TO=info@afyawise.org
# Optional per-reason routing (defaults: fund/partner/media → executive@, volunteer → programs@,
# donate → finance@, other → info@).
MAIL_ROUTE_FUND=
MAIL_ROUTE_PARTNER=
MAIL_ROUTE_VOLUNTEER=
MAIL_ROUTE_DONATE=
MAIL_ROUTE_MEDIA=
MAIL_ROUTE_OTHER=

# ---------------------------------------------------------------------------------------------
# Abuse protection
# ---------------------------------------------------------------------------------------------
RATE_LIMIT_PER_HOUR=5
# Optional: Upstash Redis (REST) makes the rate limit hold across serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------------------------
# Donations (only live methods are shown; until these are set, the site shows bank transfer and a
# "Request M-Pesa details" email link)
# ---------------------------------------------------------------------------------------------
# Card donations: off | paystack
PUBLIC_DONATE_CARD=off
PAYSTACK_SECRET_KEY=

# M-Pesa: off | paybill | stk
#   paybill = show the Pay Bill number and account below
#   stk     = one-tap STK Push prompt via Safaricom Daraja (needs the MPESA_* credentials)
PUBLIC_DONATE_MPESA=off
PUBLIC_MPESA_PAYBILL=
PUBLIC_MPESA_ACCOUNT=
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Random string that protects the M-Pesa callback URL (e.g. `openssl rand -hex 24`).
MPESA_CALLBACK_TOKEN=

# ---------------------------------------------------------------------------------------------
# Privacy-first analytics (cookieless). none | plausible | umami | vercel
# ---------------------------------------------------------------------------------------------
PUBLIC_ANALYTICS_PROVIDER=none
PUBLIC_ANALYTICS_DOMAIN=afyawise.org
# Script URL for self-hosted Plausible/Umami (default Plausible: https://plausible.io/js/script.js)
PUBLIC_ANALYTICS_SRC=
PUBLIC_UMAMI_WEBSITE_ID=

# ---------------------------------------------------------------------------------------------
# Chatbot (click-to-load). Leave empty to switch it off. Current AfyaWise bot: 5ZAehRlPhzYA_DLa0CLb7
# ---------------------------------------------------------------------------------------------
PUBLIC_CHATBASE_ID=

# ---------------------------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------------------------
# vercel (default on Vercel) | node (default locally; used for preview and QA)
ASTRO_ADAPTER=
