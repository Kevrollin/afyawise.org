{
  "name": "afyawise-org",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AfyaWise CBO website: community-led primary health care in Meru County, Kenya.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild.mjs",
    "build:vercel": "cross-env ASTRO_ADAPTER=vercel astro build && node scripts/postbuild.mjs",
    "preview": "cross-env HOST=127.0.0.1 PORT=4321 node dist/server/entry.mjs",
    "check": "astro check",
    "lint": "eslint .",
    "lint:copy": "node scripts/lint-copy.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run lint:copy && npm run check && npm run lint && npm run format:check",
    "test:e2e": "playwright test",
    "qa:html": "html-validate \"dist/client/**/*.html\"",
    "qa:links": "linkinator http://127.0.0.1:4321 --config linkinator.config.json",
    "qa:screens": "node scripts/qa/screens.mjs --landscape",
    "qa:lighthouse": "node scripts/audit/lighthouse.mjs --base http://127.0.0.1:4321 --out qa/lighthouse --desktop / /programs /programs/maternal-child-health /programs/water-sanitation-hygiene /programs/mental-health-disability /programs/health-education /programs/community-health-promoters /impact /partner /donate /get-involved /contact /about /privacy /terms",
    "qa:lhci": "lhci autorun",
    "brand": "node scripts/brand.mjs",
    "fonts": "node scripts/fonts.mjs",
    "map": "node scripts/map.mjs",
    "og": "node scripts/og.mjs",
    "audit:crawl": "node scripts/audit/crawl.mjs",
    "audit:ctas": "node scripts/audit/ctas.mjs",
    "audit:assets": "node scripts/audit/assets.mjs",
    "audit:lighthouse": "node scripts/audit/lighthouse.mjs --base https://www.afyawise.org --out audit/lighthouse --desktop"
  },
  "dependencies": {
    "@astrojs/node": "11.1.9",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/vercel": "11.0.18",
    "@lucide/astro": "1.66.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.5",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@typescript-eslint/parser": "8.72.1",
    "astro-eslint-parser": "3.2.0",
    "cross-env": "10.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "globals": "17.14.0",
    "html-validate": "11.18.0",
    "lighthouse": "13.6.0",
    "linkinator": "8.1.0",
    "opentype.js": "2.0.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "subset-font": "2.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
