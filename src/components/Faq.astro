---
/** FAQ with native <details>: keyboard and screen-reader friendly, zero JS. */
import type { Faq } from '../content/types.ts';
import Icon from './Icon.astro';
import { visible } from '../lib/visibility.ts';

interface Props {
  items: Faq[];
}
const shown = visible(Astro.props.items);
---

<div class="divide-y divide-line rounded-lg border border-line bg-bg">
  {shown.map((item) => (
    <details class="faq group">
      <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-5 py-4">
        <h3 class="text-lg">{item.question}</h3>
        <Icon
          name="chevron-down"
          size={22}
          class="shrink-0 text-green-700 transition-transform group-open:rotate-180"
        />
      </summary>
      <p class="px-5 pb-5 text-ink-muted">{item.answer}</p>
    </details>
  ))}
</div>

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary:hover h3 {
    color: var(--af-green-800);
  }
</style>
