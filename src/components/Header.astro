---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { primaryNav, isCurrent } from '../lib/nav.ts';
import { useStrings } from '../i18n/index.ts';
import { getContent } from '../content/index.ts';

const t = useStrings().nav;
const { org } = getContent();
const nav = await primaryNav();
const path = Astro.url.pathname;
---

<div id="header-sentinel" aria-hidden="true"></div>
<header class="site-header" data-header>
  <div class="container-site flex items-center justify-between gap-4">
    <a href="/" class="logo-link" aria-label={t.homeLink}>
      <Logo height={40} class="logo h-8 w-auto sm:h-10" />
    </a>

    <nav aria-label={t.label} class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {nav.map((item) => (
          <li>
            <a href={item.href} class="nav-link" aria-current={isCurrent(item.href, path) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href="/donate" class="btn btn--accent btn--sm" data-event="Donate" data-event-location="header">
        {t.donate}
      </a>
      <button
        type="button"
        class="menu-button inline-flex lg:hidden"
        popovertarget="mobile-nav"
        aria-controls="mobile-nav"
        aria-expanded="false"
        data-menu-button
      >
        <Icon name="menu" size={22} />
        <span class="max-[359px]:sr-only">{t.menu}</span>
      </button>
    </div>
  </div>
</header>

<nav id="mobile-nav" popover aria-label={t.drawerLabel} class="mobile-nav">
  <div class="flex items-center justify-between border-b border-line px-4 py-3">
    <a href="/" aria-label={t.homeLink} class="logo-link">
      <Logo height={36} />
    </a>
    <button
      type="button"
      class="menu-button inline-flex"
      popovertarget="mobile-nav"
      popovertargetaction="hide"
      aria-label={t.closeMenu}
    >
      <Icon name="x" size={22} />
    </button>
  </div>
  <ul class="flex flex-col p-2">
    <li>
      <a href="/" class="mobile-link" aria-current={path === '/' ? 'page' : undefined}>
        {t.home}
      </a>
    </li>
    {nav.map((item) => (
      <li>
        <a href={item.href} class="mobile-link" aria-current={isCurrent(item.href, path) ? 'page' : undefined}>
          {item.label}
        </a>
      </li>
    ))}
  </ul>
  <div class="mt-auto grid gap-2 border-t border-line p-4">
    <a href="/donate" class="btn btn--accent" data-event="Donate" data-event-location="mobile-menu">
      {t.donate}
    </a>
    <a href={`mailto:${org.email.general}`} class="mobile-contact">
      {org.email.general}
    </a>
    <a href={org.phone.href} class="mobile-contact">
      {org.phone.display}
    </a>
  </div>
</nav>

<style>
  #header-sentinel {
    position: absolute;
    top: 0;
    height: 1px;
    width: 1px;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--af-z-header);
    background: rgb(255 255 255 / 0.96);
    border-bottom: 1px solid transparent;
    transition:
      box-shadow var(--af-duration-base) ease,
      border-color var(--af-duration-base) ease;
  }
  @supports (backdrop-filter: blur(8px)) {
    .site-header {
      background: rgb(255 255 255 / 0.86);
      backdrop-filter: saturate(1.4) blur(10px);
    }
  }
  .site-header > div {
    min-height: var(--af-header-h);
    transition: min-height var(--af-duration-base) var(--af-ease-out);
  }
  .site-header[data-scrolled] {
    border-color: var(--af-line);
    box-shadow: var(--af-shadow-sm);
  }
  .site-header[data-scrolled] > div {
    min-height: var(--af-header-h-compact);
  }
  .logo-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--af-tap);
    border-radius: var(--af-radius-sm);
  }
  .logo-link :global(.logo) {
    transition:
      height var(--af-duration-base) var(--af-ease-out),
      width var(--af-duration-base) var(--af-ease-out);
  }
  .site-header[data-scrolled] .logo-link :global(.logo) {
    height: 34px;
    width: auto;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--af-tap);
    padding-inline: 0.75rem;
    border-radius: var(--af-radius-pill);
    color: var(--af-ink);
    font-weight: 600;
    font-size: var(--af-step--1);
    text-decoration: none;
    transition:
      background-color var(--af-duration-fast) ease,
      color var(--af-duration-fast) ease;
  }
  .nav-link:hover {
    background: var(--af-green-50);
    color: var(--af-green-800);
  }
  .nav-link[aria-current='page'] {
    color: var(--af-green-800);
    background: var(--af-green-50);
    box-shadow: inset 0 -2px 0 var(--af-green-700);
  }
  .menu-button {
    align-items: center;
    gap: 0.375rem;
    min-height: var(--af-tap);
    min-width: var(--af-tap);
    padding-inline: 0.75rem;
    border: 1px solid var(--af-line);
    border-radius: var(--af-radius-pill);
    background: var(--af-bg);
    font-weight: 600;
    font-size: var(--af-step--1);
    cursor: pointer;
  }
  .menu-button:hover {
    background: var(--af-green-50);
  }

  /* Drawer (Popover API: opens and closes without JS; Esc and outside-click close it). */
  .mobile-nav {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(22rem, 88vw);
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    border-left: 1px solid var(--af-line);
    background: var(--af-bg);
    color: var(--af-ink);
    box-shadow: var(--af-shadow-lg);
    overflow-y: auto;
    flex-direction: column;
    /* Hidden by default even where `popover` is unsupported (the footer nav covers no-JS users). */
    display: none;
  }
  .mobile-nav:popover-open,
  .mobile-nav.is-open {
    display: flex;
  }
  .mobile-nav::backdrop {
    background: rgb(12 46 21 / 0.45);
  }
  @media (prefers-reduced-motion: no-preference) {
    .mobile-nav {
      transition:
        translate var(--af-duration-slow) var(--af-ease-out),
        overlay var(--af-duration-slow) allow-discrete,
        display var(--af-duration-slow) allow-discrete;
      translate: 100% 0;
    }
    .mobile-nav:popover-open {
      translate: 0 0;
    }
    @starting-style {
      .mobile-nav:popover-open {
        translate: 100% 0;
      }
    }
  }
  .mobile-link {
    display: flex;
    align-items: center;
    min-height: 3rem;
    padding-inline: 1rem;
    border-radius: var(--af-radius-md);
    color: var(--af-ink);
    font-weight: 600;
    font-size: var(--af-step-1);
    text-decoration: none;
  }
  .mobile-link:hover {
    background: var(--af-green-50);
  }
  .mobile-contact {
    display: flex;
    align-items: center;
    min-height: var(--af-tap);
    padding-inline: 0.5rem;
    color: var(--af-green-800);
    font-size: var(--af-step--1);
    font-weight: 600;
  }
  .mobile-link[aria-current='page'] {
    background: var(--af-green-50);
    color: var(--af-green-800);
    box-shadow: inset 3px 0 0 var(--af-green-700);
  }
</style>

<script>
  // Compact header once the page scrolls (one observer, no scroll listeners).
  const header = document.querySelector<HTMLElement>('[data-header]');
  const sentinel = document.getElementById('header-sentinel');
  if (header && sentinel && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => header.toggleAttribute('data-scrolled', !entry?.isIntersecting)).observe(
      sentinel,
    );
  }

  // Mobile drawer: keep aria-expanded in sync, focus the first link, and support browsers without popover.
  const drawer = document.getElementById('mobile-nav');
  const opener = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  if (drawer && opener) {
    const supportsPopover = 'popover' in HTMLElement.prototype;
    const setOpen = (open: boolean) => {
      opener.setAttribute('aria-expanded', String(open));
      if (open) drawer.querySelector<HTMLAnchorElement>('.mobile-link')?.focus();
      else if (drawer.contains(document.activeElement) || document.activeElement === document.body) opener.focus();
    };
    if (supportsPopover) {
      drawer.addEventListener('toggle', (e) => setOpen((e as ToggleEvent).newState === 'open'));
    } else {
      // Fallback: plain toggle.
      drawer.hidden = true;
      const toggle = (open: boolean) => {
        drawer.hidden = !open;
        drawer.classList.toggle('is-open', open);
        setOpen(open);
      };
      opener.addEventListener('click', () => toggle(Boolean(drawer.hidden)));
      drawer.querySelector('[popovertargetaction="hide"]')?.addEventListener('click', () => toggle(false));
      document.addEventListener('keydown', (e) => e.key === 'Escape' && !drawer.hidden && toggle(false));
    }
  }
</script>
