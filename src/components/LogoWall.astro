---
/** Partner logos. Renders only partners that are confirmed AND gave written permission. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Partner } from '../content/types.ts';

interface Props {
  partners: Partner[];
}
const { partners } = Astro.props;
const logos = import.meta.glob<{ default: ImageMetadata }>('../assets/partners/*.{png,jpg,jpeg,svg,webp}', {
  eager: true,
});
const shown = partners.filter(
  (p) => p.status === 'confirmed' && p.logoPermission && logos[`../assets/partners/${p.logo}`],
);
---

{shown.length > 0 && (
  <ul class="grid grid-cols-2 items-center gap-6 sm:grid-cols-3 lg:grid-cols-6">
    {shown.map((p) => (
      <li>
        <a
          href={p.url}
          rel="noopener"
          class="flex min-h-20 items-center justify-center rounded-md p-3 hover:bg-surface"
        >
          <Image
            src={logos[`../assets/partners/${p.logo}`]!.default}
            alt={p.name}
            height={56}
            class="h-14 w-auto object-contain"
          />
        </a>
      </li>
    ))}
  </ul>
)}
