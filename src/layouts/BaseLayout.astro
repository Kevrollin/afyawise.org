---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChatFacade from '../components/ChatFacade.astro';
import Analytics from '../components/Analytics.astro';
import { getContent } from '../content/index.ts';
import { useStrings, locales } from '../i18n/index.ts';
import { organizationLd, websiteLd, absolute } from '../lib/seo.ts';

interface Props {
  title: string;
  description: string;
  /** Name of the OG image in /public/og (without .png). */
  og?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  /** Pages like 404 and form results set this so they are not indexed or put in the sitemap. */
  canonical?: string | null;
}

const { title, description, og = 'default', noindex = false, jsonLd = [], canonical } = Astro.props;
const content = getContent();
const t = useStrings();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonicalUrl = canonical === null ? null : absolute(canonical ?? path);
const ogImage = absolute(`/og/${og}.png`);
const ld = [organizationLd(content), websiteLd(content), ...jsonLd];
---

<!doctype html>
<html lang={t.lang} dir={t.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    {locales.length > 1 &&
      canonicalUrl &&
      locales.map((l) => <link rel="alternate" hreflang={l} href={absolute(l === 'en' ? path : `/${l}${path}`)} />)}

    <Font cssVariable="--font-inter" preload />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AfyaWise" />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title}. AfyaWise logo on green.`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {ld.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
    <Analytics />
  </head>
  <body class="flex min-h-dvh flex-col bg-bg">
    <a href="#main" class="skip-link">
      {t.skipLink}
    </a>
    <Header />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer />
    <ChatFacade />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -10rem;
    z-index: 100;
    padding: 0.75rem 1rem;
    border-radius: var(--af-radius-md);
    background: var(--af-green-950);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }
  .skip-link:focus {
    top: 1rem;
    color: #fff;
  }
</style>

<script>
  // Conversion events for cookieless analytics: any element with data-event="Fund|Partner|Donate|Volunteer".
  document.addEventListener('click', (e) => {
    const el = (e.target as Element | null)?.closest<HTMLElement>('[data-event]');
    if (!el?.dataset.event) return;
    window.dispatchEvent(
      new CustomEvent('af:track', { detail: { name: el.dataset.event, location: el.dataset.eventLocation ?? '' } }),
    );
  });
</script>
