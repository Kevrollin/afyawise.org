---
import LegalLayout from '../layouts/LegalLayout.astro';
import { Content, frontmatter } from '../content/en/legal/terms.md';
import { getContent } from '../content/index.ts';

const { terms } = getContent().legal;
---

<LegalLayout
  title={terms.meta.title}
  description={terms.meta.description}
  headline={terms.headline}
  href="/terms"
  updated={frontmatter.updated}
>
  <Content />
</LegalLayout>
